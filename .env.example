# ==========================================
# AI Study Planner SaaS - Environment Setup
# ==========================================
# Copy this file to .env and fill in your values

# Application Configuration
APP_NAME=AI Study Planner
APP_ENV=development
APP_PORT=3000
NODE_ENV=development
LOG_LEVEL=debug

# ==========================================
# SUPABASE CLOUD DATABASE CONFIGURATION
# ==========================================
# Get these values from: https://app.supabase.com/project/_/settings/database
# 
# Format: postgresql://postgres:PASSWORD@db.PROJECT_ID.supabase.co:5432/postgres
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@db.YOUR_PROJECT_ID.supabase.co:5432/postgres"

# Supabase Project URL
SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co

# Supabase Anon Key (Public)
# From: Settings > API > Project API keys > anon (public)
SUPABASE_ANON_KEY=sb_publishable_YOUR_ANON_KEY_HERE

# Supabase Service Role Key (Secret - KEEP SECURE!)
# From: Settings > API > Project API keys > service_role (secret)
SUPABASE_SERVICE_ROLE_KEY=sb_secret_YOUR_SERVICE_ROLE_KEY_HERE

# ==========================================
# JWT CONFIGURATION
# ==========================================
# Generate a secure random string (min 32 characters)
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production_min_32_chars
JWT_EXPIRATION=15m
JWT_REFRESH_SECRET=your_refresh_secret_key_change_this_too_min_32_chars
JWT_REFRESH_EXPIRATION=7d

# ==========================================
# EMAIL SERVICE CONFIGURATION
# ==========================================
# Gmail SMTP settings for sending emails
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your-email@gmail.com
EMAIL_PASSWORD=your-app-password
EMAIL_FROM=noreply@aisstudyplanner.com

# ==========================================
# FRONTEND CONFIGURATION
# ==========================================
FRONTEND_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:3000
