enum Role {
  SUPER_ADMIN
  ADMIN
  STUDENT
}
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id               String           @id @default(uuid())
  isActive         Boolean          @default(true)
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  role             Role             @default(STUDENT)
  name             String?
  enrollmentNumber String           @unique
  course           String?
  department       String?
  semester         Int?
  supabaseId       String?
  exams            Exam[]
  progressRecords  ProgressRecord[]
  studyPlans       StudyPlan[]
  subjects         Subject[]
  topics           Topic[]
  students         Student[]
  analytics        Analytics[]
  subscriptions    Subscription[]

  @@index([enrollmentNumber])
  @@index([course])
  @@index([semester])
}

model Subject {
  id           String   @id @default(uuid())
  userId       String
  name         String
  description  String?
  academicYear String?
  semester     Int?
  priority     Int      @default(0)
  color        String?  @default("#3B82F6")
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  exams        Exam[]
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  topics       Topic[]
  degreeId     String?
  degree       Degree?  @relation(fields: [degreeId], references: [id])
  studyPlanSubjects StudyPlanSubject[]

  @@unique([userId, name, academicYear])
  @@index([userId])
  @@index([createdAt])
}

model Exam {
  id              String          @id @default(uuid())
  userId          String
  subjectId       String
  name            String
  type            String
  description     String?
  totalMarks      Float           @default(100)
  targetScore     Float?
  examinationDate DateTime
  weightage       Int             @default(0)
  isCompleted     Boolean         @default(false)
  actualScore     Float?
  notes           String?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  subject         Subject         @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  user            User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  studyPlanItems  StudyPlanItem[]
  topics          Topic[]

  @@unique([userId, subjectId, name, type])
  @@index([userId])
  @@index([subjectId])
  @@index([examinationDate])
}

model Topic {
  id              String           @id @default(uuid())
  userId          String
  subjectId       String
  examId          String
  name            String
  description     String?
  difficulty      String
  estimatedHours  Float            @default(1.0)
  priority        Int              @default(0)
  isCompleted     Boolean          @default(false)
  completedAt     DateTime?
  notes           String?
  resources       String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  progressRecords ProgressRecord[]
  studyPlanItems  StudyPlanItem[]
  exam            Exam             @relation(fields: [examId], references: [id], onDelete: Cascade)
  subject         Subject          @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, examId, name])
  @@index([userId])
  @@index([subjectId])
  @@index([examId])
}

model StudyPlan {
  id                   String          @id @default(uuid())
  userId               String
  startDate            DateTime
  endDate              DateTime
  totalWeeklyHours     Float           @default(0)
  totalDailyHours      Float           @default(0)
  generatedAt          DateTime        @default(now())
  description          String?
  isActive             Boolean         @default(true)
  completionPercentage Float           @default(0.0)
  createdAt            DateTime        @default(now())
  updatedAt            DateTime        @updatedAt
  user                 User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  items                StudyPlanItem[]

  @@index([userId])
  @@index([isActive])
}

model StudyPlanItem {
  id             String    @id @default(uuid())
  studyPlanId    String
  examId         String
  topicId        String
  scheduledDate  DateTime
  allocatedHours Float     @default(1.0)
  completedHours Float     @default(0)
  isCompleted    Boolean   @default(false)
  completedAt    DateTime?
  priority       Int       @default(0)
  notes          String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  exam           Exam      @relation(fields: [examId], references: [id], onDelete: Cascade)
  studyPlan      StudyPlan @relation(fields: [studyPlanId], references: [id], onDelete: Cascade)
  topic          Topic     @relation(fields: [topicId], references: [id], onDelete: Cascade)

  @@unique([studyPlanId, examId, topicId, scheduledDate])
  @@index([studyPlanId])
  @@index([examId])
  @@index([topicId])
  @@index([scheduledDate])
}

model ProgressRecord {
  id              String   @id @default(uuid())
  userId          String
  topicId         String
  studyDate       DateTime
  hoursSpent      Float    @default(0)
  confidenceLevel String?
  notes           String?
  rating          Float?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  topic           Topic    @relation(fields: [topicId], references: [id], onDelete: Cascade)
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([topicId])
  @@index([studyDate])
}


// --- SaaS Study Planner Additions ---

model Degree {
  id            String    @id @default(uuid())
  name          String
  durationYears Int
  totalSemesters Int
  subjects      Subject[]
  students      Student[]
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  @@unique([name, durationYears, totalSemesters])
}

model Student {
  id         String   @id @default(uuid())
  userId     String   @unique
  degreeId   String
  semester   Int
  status     StudentStatus @default(ACTIVE)
  user       User     @relation(fields: [userId], references: [id])
  degree     Degree   @relation(fields: [degreeId], references: [id])
  studyPlans StudyPlanSaas[]
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  @@index([degreeId, semester])
}

enum StudentStatus {
  ACTIVE
  INACTIVE
  GRADUATED
  SUSPENDED
}

model StudyPlanSaas {
  id           String   @id @default(uuid())
  studentId    String
  planData     Json
  generatedAt  DateTime @default(now())
  weakSubjects String[]
  student      Student  @relation(fields: [studentId], references: [id])
  subjects     StudyPlanSubject[]
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  @@index([studentId, generatedAt])
}

model StudyPlanSubject {
  id          String   @id @default(uuid())
  studyPlanId String
  subjectId   String
  progress    Float    @default(0)
  studyPlan   StudyPlanSaas @relation(fields: [studyPlanId], references: [id])
  subject     Subject   @relation(fields: [subjectId], references: [id])
  @@unique([studyPlanId, subjectId])
}

model Analytics {
  id        String   @id @default(uuid())
  userId    String
  type      String
  data      Json
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])
  @@index([userId, type])
}

model Subscription {
  id         String   @id @default(uuid())
  userId     String
  plan       SubscriptionPlan
  status     SubscriptionStatus @default(ACTIVE)
  revenue    Float    @default(0)
  startedAt  DateTime @default(now())
  endedAt    DateTime?
  user       User     @relation(fields: [userId], references: [id])
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  @@index([userId, plan, status])
}

enum SubscriptionPlan {
  FREE
  PRO
}

enum SubscriptionStatus {
  ACTIVE
  CANCELLED
  EXPIRED
}

// --- End of Additions ---
